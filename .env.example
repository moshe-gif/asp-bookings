# Copy to .env (gitignored) and fill in. NEVER commit real secrets.

# --- Server / deploy target ---
DEPLOY_HOST=your.server.ip.or.host
DEPLOY_USER=root
DEPLOY_PASS=
REMOTE_INDEX_PATH=/var/www/app/index.html
REMOTE_PROXY_PATH=/var/www/proxy.js

# --- Supabase (real auth + data; see supabase/migrations/) ---
# SUPABASE_URL is also needed server-side by backend/proxy.js to verify session JWTs against
# Supabase's JWKS. SUPABASE_PUBLISHABLE_KEY is safe to expose (it's already hardcoded in
# frontend/index.html) but listed here so a fresh clone's .env matches what's actually live.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_PASSWORD=

# --- Third-party API keys (used by the proxy, server-side ONLY) ---
ANTHROPIC_KEY=

# --- Email sending (see INTEGRATIONS.md §1; fill only what you use) ---
# HTTPS mail relay (Apps Script web app) — primary channel for servers (VPS block SMTP ports)
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
# Gmail SMTP app password — for machines that CAN reach SMTP (requires 2-Step Verification on)
SMTP_USER=
SMTP_APP_PASSWORD=
# EmailJS — FALLBACK ONLY (free-tier quota exhausts)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# --- Payments (Stripe; secret key server-side ONLY, see INTEGRATIONS.md §3) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- App config ---
APP_ORIGIN=https://app.your-domain.com

# =====================================================================================
# ASP operations automation (see ops/QUICKBOOKS_SETUP.md, ops/SEND_CONTRACT_SETUP.md,
# and the setup docs this section grows alongside as each integration below goes live).
# These are Supabase Edge Function secrets, not proxy/.env values in production -- set
# them in the Supabase Dashboard (Edge Functions -> Secrets). Listed here so a fresh
# setup knows the full list of what's needed and nothing is forgotten. Placeholders
# only -- never commit real values.
# =====================================================================================

# --- QuickBooks Online (Send Contract -> invoice, payment sync) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=production
QBO_REDIRECT_URI=https://YOUR-PROJECT.supabase.co/functions/v1/qbo-oauth-callback
QBO_WEBHOOK_VERIFIER_TOKEN=

# --- Google Calendar (HOLD/CONFIRMED sync -- ASP main calendar + one mapping per artist) ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://YOUR-PROJECT.supabase.co/functions/v1/gcal-oauth-callback

# --- Gmail (Zelle payment monitoring per artist mailbox + ASP sending mailbox + travel thread with Rivky) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://YOUR-PROJECT.supabase.co/functions/v1/gmail-oauth-callback
GMAIL_PUBSUB_TOPIC=
RIVKY_TRAVEL_EMAIL=

# --- Flight tracking (FlightAware AeroAPI, or swap for another provider behind the same adapter) ---
FLIGHTAWARE_API_KEY=
FLIGHT_STATUS_WEBHOOK_SECRET=
